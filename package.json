{
  "name": "@graveyield/sdk",
  "version": "0.2.0",
  "description": "Salvor bots SDK for GraveYield Protocol \u2014 TypeScript salvor bot toolkit for derelict-pool detection, certify-and-salvage flow, and claim helpers. Phase 8 complete: evaluatePool, recordLaunchPrice, phase1/phase2, snapshotLpHolders, buildMerkleTree, certifyAndSalvage, claimLpProceeds.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/GraveYield/salvor-bots.git"
  },
  "homepage": "https://github.com/GraveYield/salvor-bots#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "node --test --import tsx/esm --test-reporter=spec --test-name-pattern='.*' 'test/**/*.test.ts'",
    "lint": "eslint .",
    "fmt:ts": "prettier --write .",
    "fmt:ts:check": "prettier --check ."
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/web3.js": "^3.1.1",
    "@solana/spl-token": "^0.4.6",
    "bn.js": "^5.2.1"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.5",
    "@types/node": "^24.0.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "8.72.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "pnpm": {
    "overrides": {
      "toml": ">=5.0.1",
      "uuid": ">=11.1.1",
      "stream-json": ">=3.6.0",
      "@solana/web3.js": "3.1.1"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@solana/web3.js": "3.1.1"
      }
    }
  },
  "packageManager": "pnpm@9.12.0"
}
